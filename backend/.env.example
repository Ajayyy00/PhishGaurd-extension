PHISHGUARD_API_TOKEN=
# Replace with the exact origin shown on the extension's Connection settings page.
PHISHGUARD_EXTENSION_ORIGINS=chrome-extension://REPLACE_WITH_YOUR_EXTENSION_ID
PORT=5000
FLASK_ENV=production
